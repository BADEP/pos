<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="EditOrderLineInput" owl="1">
        <tr t-attf-class="order-line" t-att-data-id="this.props.item.id">
            <td>
                <t t-esc="this.props.item.name" />
            </td>
            <td>
                <input
                    t-custom-model="this.state.quantityInput"
                    t-on-change="(ev) => this.onChange(ev)"
                    type="number"
                    name="quantity"
                />
            </td>
            <td>
                <t t-esc="this.props.item.uom" />
            </td>
            <td>
                <input
                    t-custom-model="this.state.priceInput"
                    t-on-change="(ev) => this.onChange(ev)"
                    type="number"
                    name="price"
                />
            </td>
            <td t-if="this.pos.config.manual_discount">
                <input
                    t-custom-model="this.state.discountInput"
                    t-on-change="(ev) => this.onChange(ev)"
                    type="number"
                    name="discount"
                />
            </td>
        </tr>
    </t>

</templates>

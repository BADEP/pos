<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="EditOrderPopup" owl="1">
        <Dialog title.translate="Edit Order Lines">
            <main class="full-content edit-order-popup">
                <div class="order-line-window">
                    <section class="subwindow list">
                        <div class="subwindow-container">
                            <div class="subwindow-container-fix scrollable-y">
                                <table class="order-line-list">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th>Quantity</th>
                                            <th>UoM</th>
                                            <th>Price excl. VAT</th>
                                            <th
                                                t-if="this.pos.config.manual_discount"
                                            >Discount</th>
                                        </tr>
                                    </thead>
                                    <tbody
                                        class="order-line-list-contents"
                                        t-on-onchange="this._onchange"
                                    >
                                        <t
                                            t-foreach="this.state.array"
                                            t-as="item"
                                            t-key="item._id"
                                        >
                                            <EditOrderLineInput
                                                item="item"
                                                onchange="this.handleChange"
                                            />
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                </div>
                <t t-set-slot="footer">
                    <button
                        class="button confirm btn btn-lg lh-lg btn-primary"
                        t-on-click="this.confirm"
                    >
						Confirm
					</button>
                    <button
                        class="button cancel btn btn-lg lh-lg btn-secondary"
                        t-on-click="this.props.close"
                    >
						Cancel
					</button>
                </t>
            </main>
        </Dialog>
    </t>

</templates>
